# Variables de entorno para desarrollo local
# Para producción, configurar en Cloudflare Pages / Workers Dashboard

# Turso Database
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# JWT Secret para sesión del panel admin
JWT_SECRET="dev-secret-key-change-in-production-min-32-chars"

# Cloudflare R2 (Opcional si se usa binding nativo de Cloudflare Workers)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="devomatik-media"
R2_PUBLIC_URL="https://media.devomatik.com"
